# SubDub API - Environment Variables Template
# Copy this file to .env.development.local and fill in your credentials
# For production, create .env.production.local with production credentials

# ============================================================================
# CORE APPLICATION SETTINGS
# ============================================================================
NODE_ENV=development
PORT=5500
SERVER_URL=http://localhost:5500
VERCEL=

# ============================================================================
# CLERK AUTHENTICATION
# Source: https://dashboard.clerk.com
# 
# REQUIRED: Yes
# Clerk manages user authentication and identity for the application.
# ============================================================================

# Public key for frontend initialization
# Find in: Dashboard → Credentials → Publishable Key
CLERK_PUBLISHABLE_KEY=pk_test_

# Secret key for backend API calls to Clerk
# Find in: Dashboard → Credentials → Secret Key
CLERK_SECRET_KEY=sk_test_

# JWT verification key (optional but recommended for better security)
# Find in: Dashboard → Settings → API Keys → JWT Verification Key
CLERK_JWT_KEY=

# Webhook signing secret for secure webhook verification
# Find in: Dashboard → Webhooks → [Your Endpoint] → Secret
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma-separated list of origins allowed to use this app
# Example: http://localhost:3000,https://app.example.com
# Leave empty to allow all origins (not recommended for production)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:5500

# ============================================================================
# MONGODB DATABASE
# Source: https://www.mongodb.com/cloud/atlas (or self-hosted)
#
# REQUIRED: Yes
# MongoDB stores user profiles and subscription data.
# ============================================================================

# MongoDB connection URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Important: URL-encode special characters in username/password
# Example: mongodb+srv://john%40email.com:p%40ssw0rd@cluster0.mongodb.net/subdub
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/subdub

# ============================================================================
# EMAIL SERVICE (Gmail)
# Source: https://myaccount.google.com/apppasswords
#
# REQUIRED: Yes
# Sends subscription renewal reminder emails to users.
# ============================================================================

# Gmail app password (NOT your regular password)
# Steps:
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Go to App passwords: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or other)
# 4. Generate and copy the 16-character password (with spaces)
# Note: The email sender is hardcoded as sujata@jsmastery.pro
#       Change this in config/nodemailer.js if using a different account
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================================================
# UPSTASH QSTASH WORKFLOWS
# Source: https://console.upstash.com
#
# REQUIRED: Yes
# QStash manages scheduled email reminder workflows for subscriptions.
# ============================================================================

# Base URL for QStash API (usually this exact URL)
QSTASH_URL=https://qstash.upstash.io

# API token for authenticating with QStash
# Find in: Console → QStash → API Token
QSTASH_TOKEN=

# Current signing key for webhook signature verification
# Find in: Console → QStash → Webhook Configuration → Current Signing Key
# This is used to verify that webhook requests come from QStash
QSTASH_CURRENT_SIGNING_KEY=

# Next signing key for webhook verification (for key rotation)
# Find in: Console → QStash → Webhook Configuration → Signing Key Rotation
# Optional - used during key rotation
QSTASH_NEXT_SIGNING_KEY=

# ============================================================================
# ARCJET SECURITY
# Source: https://app.arcjet.com
#
# REQUIRED: No (Optional but recommended for production)
# ArcJet provides DDoS protection, rate limiting, and bot detection.
# ============================================================================

# API key for ArcJet service
# Find in: Dashboard → [Your Project] → Settings → API Keys
# Leave empty to disable ArcJet protection
ARCJET_KEY=ajk_

# Environment setting for ArcJet
# Options: LIVE (production) or STAGING (testing)
# LIVE mode blocks malicious traffic
# STAGING mode allows classified bots for testing
ARCJET_ENV=LIVE

# ============================================================================
# CORS SETTINGS
# ============================================================================

# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://app.example.com
# Leave empty to allow all origins
# In production, specify exact origins for security
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# ============================================================================
# OPTIONAL: ARCJET BYPASS TOKEN (for testing rate limits)
# ============================================================================

# Bypass token to skip ArcJet protection during testing
# Find in: ArcJet Dashboard → [Project] → Settings
# Add as header: x-arcjet-bypass: {token}
# Only use for testing, never in production
ARCJET_BYPASS_TOKEN=

# ============================================================================
# SETUP CHECKLIST
# ============================================================================
# 
# Copy this file to .env.development.local and fill in the values:
# 
# [✓] CLERK_PUBLISHABLE_KEY - From Clerk Dashboard
# [✓] CLERK_SECRET_KEY - From Clerk Dashboard  
# [✓] CLERK_WEBHOOK_SIGNING_SECRET - From Clerk Webhooks
# [✓] DB_URI - From MongoDB Atlas connection string
# [✓] EMAIL_PASSWORD - From Gmail app passwords
# [✓] QSTASH_TOKEN - From Upstash Console
# [✓] QSTASH_CURRENT_SIGNING_KEY - From QStash Webhook Config
# [✓] ARCJET_KEY - From ArcJet Dashboard (optional)
# 
# After setup, run:
#   npm install     # Install dependencies
#   npm run dev     # Start development server
#   npm start       # Start production server
#
# ============================================================================
