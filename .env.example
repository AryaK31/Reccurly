# Clerk Authentication
# Get your keys from https://dashboard.clerk.com
# Development: Use pk_test_* keys
# Production: Use pk_live_* keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# PostHog Analytics (Optional)
POSTHOG_PROJECT_TOKEN=phc_your_token_here
POSTHOG_HOST=https://us.i.posthog.com

# Backend API (for Expo app -> subscription server)
# Example (iOS simulator): http://127.0.0.1:5001
# Example (Android emulator): http://10.0.2.2:5001
EXPO_PUBLIC_API_BASE_URL=http://172.17.68.16:5500

# Optional: only for cloud/webcontainer environments.
# Keep unset for normal local development on your machine.
# EXPO_FORCE_WEBCONTAINER_ENV=1
